# Express server port.
PORT=3000

# Set to "production" only for deployed runtime cookie/SSL behavior.
NODE_ENV=development

# PostgreSQL connection string used by Prisma and connect-pg-simple.
DATABASE_URL=

# Secret used to sign Express session cookies.
SESSION_SECRET=

# S3-compatible object storage configuration.
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
